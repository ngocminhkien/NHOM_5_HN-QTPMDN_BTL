<?xml version="1.0" encoding="utf-8"?>
<odoo>
    <data>
        <record id="view_tai_san_search" model="ir.ui.view">
            <field name="name">tai.san.search</field>
            <field name="model">tai_san</field>
            <field name="arch" type="xml">
                <search string="Tìm kiếm Tài sản">
                    <field name="ma_tai_san"/>
                    <field name="ten_tai_san"/>
                    <field name="nguoi_quan_ly_id"/> 
                    <field name="danh_muc_ts_id"/>
                    
                    <group expand="0" string="Nhóm theo">
                        <filter string="Loại tài sản" name="group_by_category" context="{'group_by': 'danh_muc_ts_id'}"/>
                        <filter string="Bộ phận sử dụng" name="group_by_department" context="{'group_by': 'bo_phan_su_dung_id'}"/>
                        <filter string="Trạng thái" name="group_by_status" context="{'group_by': 'state'}"/>
                    </group>
                </search>
            </field>
        </record>

        <record id="view_tai_san_tree" model="ir.ui.view">
            <field name="name">tai.san.tree</field>
            <field name="model">tai_san</field>
            <field name="arch" type="xml">
                <tree string="Danh sách Tài sản" decoration-muted="state == 'in_use'">
                    <field name="ma_tai_san"/>
                    <field name="ten_tai_san"/>
                    <field name="danh_muc_ts_id"/>
                    <field name="nguoi_quan_ly_id"/>
                    <field name="bo_phan_su_dung_id"/>
                    <field name="ngay_mua_ts"/>
                    <field name="gia_tri_hien_tai" sum="Tổng giá trị" widget="monetary" options="{'currency_field': 'don_vi_tien_te'}"/>
                    <field name="don_vi_tien_te" invisible="1"/>
                    <field name="state" widget="badge" 
                           decoration-success="state == 'in_use'" 
                           decoration-info="state == 'draft'"/>
                </tree>
            </field>
        </record>

        <record id="view_tai_san_form" model="ir.ui.view">
            <field name="name">tai.san.form</field>
            <field name="model">tai_san</field>
            <field name="arch" type="xml">
                <form string="Thông tin Tài sản">
                    <header>
                        <button name="action_confirm" string="Xác nhận" type="object" 
                                class="oe_highlight" attrs="{'invisible': [('state', '!=', 'draft')]}"/>
                        
                        <button name="action_tinh_khau_hao" string="Tính Khấu Hao Ngay" type="object" 
                                attrs="{'invisible': [('pp_khau_hao', '=', 'none')]}"/>
                        
                        <field name="state" widget="statusbar" statusbar_visible="draft,in_use"/>
                    </header>
                    
                    <sheet>
                        <field name="hinh_anh" widget="image" class="oe_avatar"/>
                        
                        <div class="oe_title">
                            <label for="ten_tai_san" class="oe_edit_only"/>
                            <h1><field name="ten_tai_san" placeholder="Ví dụ: Laptop Dell XPS 15..."/></h1>
                            <h3><field name="ma_tai_san" placeholder="Mã tài sản"/></h3>
                        </div>

                        <group>
                            <group string="Thông tin chung">
                                <field name="danh_muc_ts_id"/>
                                <field name="ngay_mua_ts"/>
                                <field name="don_vi_tinh"/>
                                <field name="don_vi_tien_te" invisible="1"/>
                            </group>
                            <group string="Giá trị &amp; Khấu hao">
                                <field name="gia_tri_ban_dau" widget="monetary" options="{'currency_field': 'don_vi_tien_te'}"/>
                                <field name="gia_tri_hien_tai" widget="monetary" options="{'currency_field': 'don_vi_tien_te'}"/>
                                <field name="pp_khau_hao"/>
                                <field name="thoi_gian_toi_da" attrs="{'invisible': [('pp_khau_hao', '!=', 'straight-line')]}"/>
                                <field name="ty_le_khau_hao" attrs="{'invisible': [('pp_khau_hao', '!=', 'degressive')]}"/>
                            </group>
                        </group>

                        <notebook>
                            <page string="Quản lý (Hội nhập)">
                                <group>
                                    <group string="Nhân sự (HRM)">
                                        <field name="nguoi_quan_ly_id"/>
                                        <field name="bo_phan_su_dung_id"/>
                                    </group>
                                    <group string="Kế toán (Accounting)">
                                        <field name="account_id" placeholder="Gõ 211 hoặc 642..."/>
                                        <field name="tai_khoan_khau_hao_id" placeholder="Chọn TK 214..."/>
                                        <field name="tai_khoan_chi_phi_id" placeholder="Chọn TK 642..."/>
                                    </group>
                                </group>
                            </page>

                            <page string="Khấu hao" name="depreciation_tab">
                                <field name="lich_su_khau_hao_ids">
                                    <tree editable="bottom" create="0">
                                        <field name="ngay_khau_hao"/>
                                        <field name="so_tien_khau_hao" sum="Tổng khấu hao"/>
                                        <field name="gia_tri_con_lai"/>
                                        <field name="loai_phieu"/>
                                        <field name="ghi_chu"/>
                                    </tree>
                                </field>
                            </page>

                            <page string="Lịch sử phân bổ">
                                <field name="phong_ban_su_dung_ids" readonly="1"/>
                            </page>
                            
                            <page string="Lịch sử kỹ thuật">
                                <field name="lich_su_ky_thuat_ids">
                                    <tree editable="bottom">
                                        <field name="ngay"/>
                                        <field name="noi_dung"/>
                                        <field name="ghi_chu"/>
                                    </tree>
                                </field>
                            </page>
                        </notebook>
                    </sheet>
                    
                    <div class="oe_chatter">
                        <field name="message_follower_ids"/>
                        <field name="activity_ids"/>
                        <field name="message_ids"/>
                    </div>
                </form>
            </field>
        </record>

        <record id="action_tai_san" model="ir.actions.act_window">
            <field name="name">Quản lý Tài sản</field>
            <field name="res_model">tai_san</field>
            <field name="view_mode">tree,form</field>
            <field name="help" type="html">
                <p class="o_view_nocontent_smiling_face">
                    Tạo tài sản đầu tiên của bạn!
                </p>
            </field>
        </record>
    </data>
</odoo>