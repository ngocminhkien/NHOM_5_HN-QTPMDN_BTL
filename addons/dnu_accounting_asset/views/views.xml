<odoo>
    <record id="view_tai_san_form_inherit" model="ir.ui.view">
        <field name="name">tai.san.form.inherit</field>
        <field name="model">quan_ly_tai_san.tai_san</field>
        <field name="inherit_id" ref="quan_ly_tai_san.view_tai_san_form"/> <!-- Kiểm tra đúng ID view gốc -->
        <field name="arch" type="xml">
            <!-- Thêm nút Xác nhận vào thanh Header -->
            <xpath expr="//header" position="inside">
                <button name="action_confirm_asset" string="Xác nhận bắt đầu sử dụng" 
                        type="object" class="oe_highlight" attrs="{'invisible': [('state', '!=', 'draft')]}"/>
                <field name="state" widget="statusbar"/>
            </xpath>

            <!-- Thêm 2 trường tài khoản kế toán -->
            <xpath expr="//group" position="inside">
                <group string="Cấu hình kế toán">
                    <field name="asset_account_id"/>
                    <field name="expense_account_id"/>
                </group>
            </xpath>

            <!-- Thêm Tab Bảng khấu hao -->
            <xpath expr="//notebook" position="inside">
                <page string="Bảng khấu hao">
                    <field name="depreciation_line_ids" readonly="1">
                        <tree>
                            <field name="name"/>
                            <field name="depreciation_date"/>
                            <field name="amount" sum="Tổng tiền"/>
                        </tree>
                    </field>
                </page>
            </xpath>
        </field>
    </record>
</odoo>