<?xml version="1.0" encoding="utf-8"?>
<odoo>
    <record id="view_dnu_asset_form_accounting" model="ir.ui.view">
        <field name="name">dnu.asset.form.accounting</field>
        <field name="model">dnu.asset</field>
        <field name="inherit_id" ref="dnu_asset.view_dnu_asset_form"/>
        <field name="arch" type="xml">
            <xpath expr="//sheet" position="inside">
                <!-- Ẩn giao diện để nhường chỗ cho module dnu_accounting_asset thể hiện chi tiết -->
                <group invisible="1">
                    <field name="account_asset_id"/>
                    <field name="method"/>
                    <field name="depreciated_value"/>
                </group>
                <group invisible="1">
                    <field name="depreciation_line_ids">
                        <tree editable="bottom">
                            <!-- Cập nhật lại tên chuẩn theo đúng Python model mới -->
                            <field name="depreciation_date"/>
                            <field name="amount"/>
                            <field name="state"/>
                            <field name="move_id"/>
                        </tree>
                    </field>
                </group>
            </xpath>
        </field>
    </record>
</odoo>
