<?xml version="1.0" encoding="utf-8"?>
<odoo>
    <record id="view_nhan_vien_assets_form" model="ir.ui.view">
        <field name="name">nhan.vien.assets.form</field>
        <field name="model">nhan_vien</field>
        <!-- Sửa External ID từ hr.view_employee_form thành nhan_su.view_nhan_vien_form -->
        <field name="inherit_id" ref="nhan_su.view_nhan_vien_form"/>
        <field name="arch" type="xml">
            <xpath expr="//notebook" position="inside">
                <page string="Tài sản (Quản lý cấp phát)">
                    <field name="asset_ids">
                        <tree editable="bottom">
                            <field name="code"/>
                            <field name="name"/>
                            <field name="location"/>
                            <field name="state"/>
                        </tree>
                    </field>
                </page>
            </xpath>
        </field>
    </record>
</odoo>
