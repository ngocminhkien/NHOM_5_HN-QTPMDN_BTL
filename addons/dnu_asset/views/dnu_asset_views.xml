<?xml version="1.0" encoding="utf-8"?>
<odoo>
    <record id="view_dnu_asset_tree" model="ir.ui.view">
        <field name="name">dnu.asset.tree</field>
        <field name="model">dnu.asset</field>
        <field name="arch" type="xml">
            <tree>
                <field name="code"/>
                <field name="name"/>
                <field name="user_id"/>
                <field name="location"/>
                <field name="state"/>
            </tree>
        </field>
    </record>

    <record id="view_dnu_asset_form" model="ir.ui.view">
        <field name="name">dnu.asset.form</field>
        <field name="model">dnu.asset</field>
        <field name="arch" type="xml">
            <form>
                <sheet>
                    <group>
                        <field name="code"/>
                        <field name="name"/>
                        <field name="user_id"/>
                        <field name="location"/>
                        <field name="remaining_value"/>
                        <field name="state"/>
                    </group>
                </sheet>
                <!-- CHATTER WIDGET -->
                <div class="oe_chatter">
                    <field name="message_follower_ids" widget="mail_followers"/>
                    <field name="activity_ids" widget="mail_activity"/>
                    <field name="message_ids" widget="mail_thread"/>
                </div>
            </form>
        </field>
    </record>

    <record id="view_dnu_asset_kanban" model="ir.ui.view">
        <field name="name">dnu.asset.kanban</field>
        <field name="model">dnu.asset</field>
        <field name="arch" type="xml">
            <!-- Gom nhóm tự động theo Tình trạng -->
            <kanban default_group_by="state" class="o_kanban_mobile">
                <field name="name"/>
                <field name="user_id"/>
                <field name="state"/>
                <field name="qr_image"/>
                <templates>
                    <t t-name="kanban-box">
                        <div t-attf-class="oe_kanban_global_click">
                            <div class="o_kanban_record_top">
                                <div class="o_kanban_record_headings">
                                    <strong class="o_kanban_record_title" style="font-size: 14px;">
                                        <field name="name"/>
                                    </strong>
                                </div>
                                <!-- Badge hiển thị Màu sắc Trạng thái -->
                                <div class="o_kanban_record_top_right">
                                    <t t-if="record.state.raw_value == 'in_use'">
                                        <span class="badge" style="background-color: #28a745; color: white;">Đang dùng</span>
                                    </t>
                                    <t t-elif="record.state.raw_value == 'maintenance'">
                                        <span class="badge" style="background-color: #ffc107; color: black;">Bảo trì</span>
                                    </t>
                                    <t t-elif="record.state.raw_value == 'retired'">
                                        <span class="badge" style="background-color: #dc3545; color: white;">Thanh lý</span>
                                    </t>
                                    <t t-else="">
                                        <span class="badge" style="background-color: #6c757d; color: white;">Mới</span>
                                    </t>
                                </div>
                            </div>
                            <div class="o_kanban_record_body" style="margin-top:10px;">
                                <div style="display: flex; justify-content: space-between; align-items: center;">
                                    <div>
                                        <span><i class="fa fa-user" title="Người sử dụng"/><field name="user_id"/></span>
                                    </div>
                                    <div>
                                        <field name="qr_image" widget="image" options="{'size': [50, 50]}"/>
                                    </div>
                                </div>
                            </div>
                        </div>
                    </t>
                </templates>
            </kanban>
        </field>
    </record>

    <record id="action_dnu_asset" model="ir.actions.act_window">
        <field name="name">Tài sản DNU</field>
        <field name="res_model">dnu.asset</field>
        <!-- Khởi tạo Kanban làm màn hình đầu tiên (Mặc định) -->
        <field name="view_mode">kanban,tree,form</field>
    </record>

    <menuitem id="menu_dnu_asset_root" name="Tài sản DNU"/>
    <menuitem id="menu_dnu_asset" name="Danh sách tài sản" parent="menu_dnu_asset_root" action="action_dnu_asset"/>
</odoo>
